# Copy to .env (gitignored) and adjust. Only POSTGRES_PASSWORD is required.

# Database password for the bundled PostgreSQL (required)
POSTGRES_PASSWORD=

# Image tag to run (default: latest)
# NOT_A_CAD_TAG=0.1.0

# Host port (default 8787)
# PORT=8787

# Public origin when behind a reverse proxy, e.g. https://cad.example.com.
# Used for OAuth metadata, links given to agents and share pages. Empty: taken from X-Forwarded-Proto/Host or the request.
# PUBLIC_URL=

# How long an agent approval request waits, in ms (default 120000)
# AUTH_REQUEST_TTL_MS=120000

# Abuse limits (defaults shown)
# MAX_SESSIONS=2000            # workspaces stored
# MAX_SESSION_BYTES=1000000    # sources per workspace
# MAX_TOTAL_BYTES=200000000    # sources of all workspaces
# MAX_BUNDLE_BYTES=524288000   # mesh bundle cache on disk (500 MB)
# MAX_CONNECTIONS=300          # open browser sockets
# MAX_CONNECTIONS_PER_IP=10
# MCP_PER_MINUTE=240           # MCP requests per IP
# WS_PER_MINUTE=30             # socket opens per IP
# OAUTH_PER_MINUTE=60          # OAuth requests per IP and endpoint
